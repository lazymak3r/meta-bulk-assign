{% comment %}
  Metafield Auto Display - App Embed
  Displays metafields configured in the Meta Bulk Assign app instantly
  by reading directly from Liquid (no API call needed)
{% endcomment %}

{% if request.page_type == 'product' %}

{% assign display_config = shop.metafields.meta_bulk_assign.storefront_display_config %}
{% assign config_value = display_config.value | default: empty %}

<script>
(function() {
  'use strict';

  const displayConfig = {% if config_value != empty %}{{ config_value | json }}{% else %}{}{% endif %};

  if (!displayConfig || Object.keys(displayConfig).length === 0) {
    return;
  }

  const metafieldData = {};

  {% if config_value != empty %}
    {% for item in config_value %}
      {% assign mf_full_key = item[0] %}
      {% assign key_parts = mf_full_key | split: '.' %}
      {% assign mf_namespace = key_parts[0] %}
      {% assign mf_key = key_parts[1] %}
      {% assign mf = product.metafields[mf_namespace][mf_key] %}

      {% if mf != blank %}
        {% if mf.type == 'list.metaobject_reference' %}
          metafieldData['{{ mf_full_key }}'] = [
            {% for obj in mf.value %}
              {
                {% if obj.image.value %}
                  "icon": "{{ obj.image.value | image_url }}",
                {% elsif obj.icon.value %}
                  "icon": "{{ obj.icon.value | image_url }}",
                {% elsif obj.bild.value %}
                  "icon": "{{ obj.bild.value | image_url }}",
                {% endif %}
                {% if obj.text.value %}
                  "text": {{ obj.text.value | json }},
                {% elsif obj.label.value %}
                  "text": {{ obj.label.value | json }},
                {% elsif obj.title.value %}
                  "text": {{ obj.title.value | json }},
                {% elsif obj.name.value %}
                  "text": {{ obj.name.value | json }},
                {% endif %}
                {% if obj.file.value %}
                  "pdf": "{{ obj.file.value.url }}"
                {% elsif obj.pdf.value %}
                  "pdf": "{{ obj.pdf.value.url }}"
                {% elsif obj.document.value %}
                  "pdf": "{{ obj.document.value.url }}"
                {% else %}
                  "_": true
                {% endif %}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ];

        {% elsif mf.type == 'list.file_reference' %}
          metafieldData['{{ mf_full_key }}'] = [
            {% for file in mf.value %}
              {% assign file_url = file.url %}
              {% assign img_url = file | image_url %}
              {% if file_url != blank and file_url != '' %}
                "{{ file_url }}"
              {% elsif img_url != blank and img_url != '' %}
                "{{ img_url }}"
              {% else %}
                ""
              {% endif %}
              {% unless forloop.last %},{% endunless %}
            {% endfor %}
          ];

        {% elsif mf.type == 'metaobject_reference' %}
          {% assign obj = mf.value %}
          metafieldData['{{ mf_full_key }}'] = {
            {% if obj.icon.value %}
              "icon": "{{ obj.icon.value | image_url }}",
            {% elsif obj.image.value %}
              "icon": "{{ obj.image.value | image_url }}",
            {% endif %}
            {% if obj.label.value %}
              "text": {{ obj.label.value | json }},
            {% elsif obj.title.value %}
              "text": {{ obj.title.value | json }},
            {% elsif obj.name.value %}
              "text": {{ obj.name.value | json }},
            {% endif %}
            {% if obj.pdf.value %}
              "pdf": "{{ obj.pdf.value.url }}"
            {% elsif obj.file.value %}
              "pdf": "{{ obj.file.value.url }}"
            {% else %}
              "_": true
            {% endif %}
          };

        {% elsif mf.type == 'file_reference' %}
          {% assign file_url = mf.value.url %}
          {% assign img_url = mf.value | image_url %}
          metafieldData['{{ mf_full_key }}'] = "{% if file_url != blank %}{{ file_url }}{% elsif img_url != blank %}{{ img_url }}{% endif %}";

        {% else %}
          metafieldData['{{ mf_full_key }}'] = {{ mf.value | json }};
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

  if (Object.keys(metafieldData).length === 0) {
    return;
  }

  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function renderEnergyLabel(data) {
    const items = Array.isArray(data) ? data : [data];
    return items.map(item => {
      if (!item || typeof item !== 'object') return '';
      const iconUrl = item.icon || '';
      const labelText = item.text || '';
      const pdfUrl = item.pdf || '';
      if (!iconUrl && !labelText && !pdfUrl) return '';
      return `
        <a href="${escapeHtml(pdfUrl)}" class="mba-energy-label" target="_blank" rel="noopener">
          ${iconUrl ? `<img src="${escapeHtml(iconUrl)}" alt="${escapeHtml(labelText)}" class="mba-energy-label-icon">` : ''}
          ${labelText ? `<span class="mba-energy-label-text">${escapeHtml(labelText)}</span>` : ''}
        </a>
      `;
    }).filter(h => h).join('');
  }

  function renderProductDetailIcon(data) {
    const items = Array.isArray(data) ? data : [data];
    return items.map(item => {
      let imageUrl = '';
      if (typeof item === 'string') {
        imageUrl = item;
      } else if (item && typeof item === 'object') {
        imageUrl = item.icon || item.image || '';
      }
      if (!imageUrl) return '';
      return `
        <div class="mba-icon-item">
          <img src="${escapeHtml(imageUrl)}" alt="Product Detail" loading="lazy">
        </div>
      `;
    }).filter(h => h).join('');
  }

  function renderWarrantyDocument(data) {
    const files = Array.isArray(data) ? data : [data];
    return files.map((item, index) => {
      let fileUrl = '';
      if (typeof item === 'string') {
        fileUrl = item;
      } else if (item && typeof item === 'object') {
        fileUrl = item.pdf || item.file || '';
      }
      if (!fileUrl) return '';
      const urlParts = fileUrl.split('/');
      const filename = urlParts[urlParts.length - 1] || `Document ${index + 1}`;
      const cleanFilename = filename.split('?')[0].replace(/^\d+_/, '') || `Document ${index + 1}`;
      return `
        <a href="${escapeHtml(fileUrl)}" target="_blank" rel="noopener noreferrer" class="mba-warranty-link">
          <svg class="mba-pdf-icon" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5.48887 8.98047H4.125C3.95373 8.98047 3.78946 9.04866 3.6685 9.16996C3.54755 9.29126 3.47991 9.45575 3.48047 9.62706L3.48997 14.5231C3.48997 14.8791 3.77855 15.1677 4.1345 15.1677C4.49045 15.1677 4.77903 14.8791 4.77903 14.5231V13.0365C5.04256 13.0352 5.32409 13.0341 5.48887 13.0341C6.62136 13.0341 7.54274 12.1248 7.54274 11.0073C7.54274 9.88969 6.62136 8.98047 5.48887 8.98047ZM5.48887 11.745C5.32263 11.745 5.04007 11.7462 4.77551 11.7475C4.77413 11.4731 4.77293 11.1776 4.77293 11.0073C4.77293 10.8615 4.7722 10.5563 4.77143 10.2695H5.48883C5.90339 10.2695 6.25363 10.6074 6.25363 11.0073C6.25363 11.4072 5.90344 11.745 5.48887 11.745Z" fill="#2E2E2D"/>
            <path d="M10.9712 8.98047H9.625C9.45386 8.98047 9.28972 9.04853 9.1688 9.16966C9.04789 9.29079 8.98013 9.45506 8.98047 9.6262C8.98047 9.62625 8.99005 14.3633 8.9901 14.3805C8.99074 14.5515 9.05923 14.7152 9.18058 14.8356C9.30136 14.9555 9.46456 15.0227 9.63463 15.0227H9.63708C9.67777 15.0226 10.638 15.0189 11.0219 15.0122C12.4783 14.9868 13.5353 13.7206 13.5353 12.0016C13.5352 10.1946 12.5049 8.98047 10.9712 8.98047ZM10.9994 13.7234C10.8324 13.7263 10.5452 13.7286 10.277 13.7304C10.2752 13.1705 10.2717 10.8513 10.2707 10.2695H10.9712C12.1543 10.2695 12.2462 11.5953 12.2462 12.0016C12.2462 12.8478 11.8607 13.7083 10.9994 13.7234Z" fill="#2E2E2D"/>
            <path d="M17.7832 10.2197C18.1391 10.2197 18.4277 9.93115 18.4277 9.5752C18.4277 9.21924 18.1391 8.93066 17.7832 8.93066H15.8125C15.4565 8.93066 15.168 9.21924 15.168 9.5752V14.4375C15.168 14.7934 15.4565 15.082 15.8125 15.082C16.1685 15.082 16.457 14.7934 16.457 14.4375V12.6048H17.6266C17.9826 12.6048 18.2712 12.3163 18.2712 11.9603C18.2712 11.6044 17.9826 11.3158 17.6266 11.3158H16.457V10.2197H17.7832Z" fill="#2E2E2D"/>
            <path d="M19.6797 6.23047H19.207V6.04661C19.207 5.21808 18.8931 4.43068 18.3231 3.82938L15.6459 1.00543C15.0401 0.36648 14.1877 0 13.3072 0H4.72656C3.66038 0 2.79297 0.86741 2.79297 1.93359V6.23047H2.32031C1.25413 6.23047 0.386719 7.09788 0.386719 8.16406V15.8984C0.386719 16.9646 1.25413 17.832 2.32031 17.832H2.79297V20.0664C2.79297 21.1326 3.66038 22 4.72656 22H17.2734C18.3396 22 19.207 21.1326 19.207 20.0664V17.832H19.6797C20.7459 17.832 21.6133 16.9646 21.6133 15.8984V8.16406C21.6133 7.09788 20.7459 6.23047 19.6797 6.23047ZM4.08203 1.93359C4.08203 1.5782 4.37117 1.28906 4.72656 1.28906H13.3072C13.8355 1.28906 14.347 1.50893 14.7104 1.89234L17.3876 4.71629C17.7296 5.07706 17.918 5.5495 17.918 6.04661V6.23047H4.08203V1.93359ZM17.918 20.0664C17.918 20.4218 17.6288 20.7109 17.2734 20.7109H4.72656C4.37117 20.7109 4.08203 20.4218 4.08203 20.0664V17.832H17.918V20.0664ZM20.3242 15.8984C20.3242 16.2538 20.0351 16.543 19.6797 16.543H2.32031C1.96492 16.543 1.67578 16.2538 1.67578 15.8984V8.16406C1.67578 7.80867 1.96492 7.51953 2.32031 7.51953H19.6797C20.0351 7.51953 20.3242 7.80867 20.3242 8.16406V15.8984Z" fill="#2E2E2D"/>
          </svg>
          <span class="mba-warranty-name">${escapeHtml(cleanFilename)}</span>
        </a>
      `;
    }).filter(h => h).join('');
  }

  function renderComponent(data, displayType) {
    switch (displayType) {
      case 'energy_label': return renderEnergyLabel(data);
      case 'product_detail_icon': return renderProductDetailIcon(data);
      case 'warranty_document': return renderWarrantyDocument(data);
      default: return '';
    }
  }

  function groupByDisplayType() {
    const groups = {};
    for (const [key, displayType] of Object.entries(displayConfig)) {
      if (metafieldData[key]) {
        if (!groups[displayType]) groups[displayType] = [];
        groups[displayType].push({ key, data: metafieldData[key] });
      }
    }
    return groups;
  }

  function findContainer(displayType) {
    return document.querySelector(`[data-meta-bulk-assign-container="${displayType}"]`);
  }

  function render() {
    const groups = groupByDisplayType();
    for (const [displayType, items] of Object.entries(groups)) {
      const container = findContainer(displayType);
      if (!container) continue;
      const html = items.map(item => renderComponent(item.data, displayType)).join('');
      if (html) {
        container.innerHTML = html;
        container.classList.add('mba-loaded');
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', render);
  } else {
    render();
  }
})();
</script>

{% endif %}

<style>
[data-meta-bulk-assign-container] {
  min-height: 0;
}

[data-meta-bulk-assign-container]:empty {
  display: none;
}

[data-meta-bulk-assign-container="energy_label"] {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  margin: 16px 0;
  align-items: flex-start;
}

@media (min-width: 768px) {
  [data-meta-bulk-assign-container="energy_label"] {
    gap: 32px;
  }
}

@media (min-width: 1024px) {
  [data-meta-bulk-assign-container="energy_label"] {
    gap: 54px;
  }
}

.mba-energy-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  flex-shrink: 0;
  transition: opacity 0.2s ease;
}

.mba-energy-label:hover {
  opacity: 0.85;
}

.mba-energy-label-icon {
  width: 61px;
  height: 24px;
  object-fit: contain;
  object-position: center;
  display: block;
}

.mba-energy-label-text {
  font-size: 12px;
  font-weight: 400;
  color: #2E2E2D;
  text-align: center;
  line-height: 1.3;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.2s ease;
}

@media (min-width: 768px) {
  .mba-energy-label-text {
    font-size: 13px;
  }
}

@media (min-width: 1024px) {
  .mba-energy-label-text {
    font-size: 14px;
  }
}

.mba-energy-label:hover .mba-energy-label-text {
  border-bottom-color: #2E2E2D;
}

[data-meta-bulk-assign-container="product_detail_icon"] {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 16px 0;
  align-items: center;
}

.mba-icon-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mba-icon-item img {
  max-height: 97px;
  max-width: 120px;
  width: auto;
  height: auto;
  object-fit: contain;
  object-position: center;
  display: block;
}

[data-meta-bulk-assign-container="warranty_document"] {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin: 12px 0;
}

.mba-warranty-link {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  text-decoration: none;
  color: #2E2E2D;
  transition: opacity 0.2s ease;
  max-width: fit-content;
}

.mba-warranty-link:hover {
  opacity: 0.7;
}

.mba-pdf-icon {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
}

.mba-warranty-name {
  font-size: 18px;
  font-weight: 400;
  line-height: 1.4;
  color: #2E2E2D;
  word-break: break-word;
}

.mba-loaded {
  animation: mba-fadeIn 0.2s ease-in;
}

@keyframes mba-fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
</style>
