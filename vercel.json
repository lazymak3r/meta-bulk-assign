{
  "version": 2,
  "installCommand": "npm install --workspaces",
  "buildCommand": "cd web/frontend && npm install && npm run build",
  "builds": [
    {
      "src": "web/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["web/frontend/dist/**"],
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/web/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}